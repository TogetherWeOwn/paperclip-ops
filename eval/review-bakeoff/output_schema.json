{
  "type": "object",
  "additionalProperties": false,
  "required": ["score", "summary", "findings", "coverage"],
  "properties": {
    "score": {"type": "integer", "minimum": 0, "maximum": 5},
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "severity", "title", "rationale", "evidence"],
        "properties": {
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "severity": {"type": "string", "enum": ["critical", "major", "minor"]},
          "title": {"type": "string"},
          "rationale": {"type": "string"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_reviewed", "complete", "limitations"],
      "properties": {
        "files_reviewed": {"type": "array", "items": {"type": "string"}},
        "complete": {"type": "boolean"},
        "limitations": {"type": "string"}
      }
    }
  }
}
