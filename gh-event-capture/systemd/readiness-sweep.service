[Unit]
Description=Single readiness reconcile pass for PR draft-ready-auto-merge gating
# One supervised pass per tick over the scanned repos: maintain the
# bot-maintained readiness block, mark-ready on green, draft-reset on a new
# head or completed failure, arm auto-merge only when CI and Paperclip Review
# pass on the exact head. Fail-closed: an undecidable PR is a counted error,
# never a green. No repeating scheduler lives in the script; this unit is the
# only 5-minute driver. Install: the Operator provisions the versioned
# checkout under %h/.local/lib/readiness-sweep/current and the 0600 policy
# file; rollback is removing the repo from enabledRepositories (or disabling
# the timer below).

[Service]
Type=oneshot
ExecStart=/usr/bin/node %h/.local/lib/readiness-sweep/current/gh-event-capture/scripts/readiness-sweep.mjs %h/secure-drop/readiness-sweep/policy.json
WorkingDirectory=%h/.local/lib/readiness-sweep/current/gh-event-capture
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
UnsetEnvironment=PAPERCLIP_API_KEY PAPERCLIP_RUN_ID GH_TOKEN GITHUB_TOKEN NODE_OPTIONS NODE_PATH
UMask=0077
TimeoutStartSec=3min
TimeoutStopSec=10s
TimeoutStartFailureMode=terminate
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
FinalKillSignal=SIGKILL
Restart=no
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal
