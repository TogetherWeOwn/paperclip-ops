+# ----------------------------------------------------------------------------------------------------
+# node7b1ff338 host-pressure gate helpers (fail closed; stdlib only).
+# ----------------------------------------------------------------------------------------------------
+import math
+
+
+class PressureError(ValueError):
+    """Required host telemetry is missing or malformed (fail closed)."""
+
+
+def _psi_avg60(kind: str, row: str, text: str) -> float:
+    """Parse one PSI avg60 value; anything missing or malformed raises."""
+    if not isinstance(text, str):
+        raise PressureError(f"{kind} PSI is unreadable")
+    rows = [line.split() for line in text.splitlines() if line.startswith(f"{row} ")]
+    if len(rows) != 1:
+        raise PressureError(f"{kind} PSI {row} row is missing or duplicated")
+    fields: dict[str, str] = {}
+    for item in rows[0][1:]:
+        key, sep, value = item.partition("=")
+        if not sep or not key or not value or key in fields:
+            raise PressureError(f"{kind} PSI row is malformed")
+        fields[key] = value
+    if "avg60" not in fields:
+        raise PressureError(f"{kind} PSI avg60 is missing")
+    try:
+        value = float(fields["avg60"])
+    except ValueError as error:
+        raise PressureError(f"{kind} PSI avg60 is malformed") from error
+    if not 0.0 <= value <= 100.0:
+        raise PressureError(f"{kind} PSI avg60 is outside 0..100")
+    return value
+
+
+def _loadavg_triplet(text: str) -> tuple[float, float, float]:
+    """Parse (load1, load5, load15); NaN/negative/missing raises."""
+    if not isinstance(text, str):
+        raise PressureError("load averages are unreadable")
+    fields = text.split()
+    if len(fields) < 3:
+        raise PressureError("load averages are incomplete")
+    try:
+        loads = (float(fields[0]), float(fields[1]), float(fields[2]))
+    except ValueError as error:
+        raise PressureError("load averages are malformed") from error
+    if any(not math.isfinite(v) or v < 0 for v in loads):
+        raise PressureError("load averages are outside the valid range")
+    return loads
+
+
+def _mem_available_bytes(text: str) -> int:
+    """Parse MemAvailable kB; anything missing or malformed raises."""
+    if not isinstance(text, str):
+        raise PressureError("MemAvailable is unreadable")
+    rows = [line.split() for line in text.splitlines() if line.startswith("MemAvailable:")]
+    if len(rows) != 1 or len(rows[0]) != 3 or rows[0][2] != "kB":
+        raise PressureError("MemAvailable is missing or malformed")
+    digits = rows[0][1]
+    if not digits.isascii() or not digits.isdecimal():
+        raise PressureError("MemAvailable is missing or malformed")
+    return int(digits) * 1024
+
+
+def node7b1ff338_pressure_veto(read_text=None) -> str | None:
+    """Return None when the host has headroom, else the veto reason.
+
+    read_text(path) defaults to the live /proc file. Missing or malformed
+    telemetry returns a veto string (fail closed); load1 alone never vetoes.
+    """
+    def read(path: str) -> str:
+        if read_text is not None:
+            return read_text(path)
+        with open(path, encoding="ascii") as handle:
+            return handle.read()
+
+    try:
+        cpu = _psi_avg60("cpu", "some", read("/proc/pressure/cpu"))
+        io = _psi_avg60("io", "some", read("/proc/pressure/io"))
+        mem_full = _psi_avg60("memory", "full", read("/proc/pressure/memory"))
+        _load1, load5, _load15 = _loadavg_triplet(read("/proc/loadavg"))
+        available = _mem_available_bytes(read("/proc/meminfo"))
+    except (PressureError, OSError, UnicodeError) as error:
+        return f"host telemetry unreadable (fail closed): {error}"
+    if cpu > node7525e5a1_CPU_SOME_MAX:
+        return f"cpu some avg60 {cpu:.1f} > {node7525e5a1_CPU_SOME_MAX:.0f}"
+    if io > node7525e5a1_IO_SOME_MAX:
+        return f"io some avg60 {io:.1f} > {node7525e5a1_IO_SOME_MAX:.0f}"
+    if mem_full > node7525e5a1_MEM_FULL_MAX:
+        return f"memory full avg60 {mem_full:.1f} > {node7525e5a1_MEM_FULL_MAX:.0f}"
+    if load5 > node7525e5a1_LOAD5_HARD_MAX:
+        return f"load5 {load5:.1f} > {node7525e5a1_LOAD5_HARD_MAX:.0f}"
+    if available < node7525e5a1_MIN_AVAILABLE_BYTES:
+        return f"MemAvailable {available // 1024**2} MiB < {node7525e5a1_MIN_AVAILABLE_BYTES // 1024**3} GiB"
+    return None
+
 
