# Copy to ~/.config/paperclip/case_705a486a.env, chmod 0600. systemd EnvironmentFile syntax.
# The Paperclip container's name as `docker ps` shows it (not committed: host-specific).
PAPERCLIP_CONTAINER=<paperclip-container-name>
# Gatus external-endpoint credentials: the SAME values as the existing push scripts' env file
# (ops/case_658bf6b9/OPERATOR.md). Do not paste them anywhere but this 0600 file.
GATUS_URL=<same as the existing push env file>
GATUS_EXTERNAL_TOKEN=<same as the existing push env file>
# The sensor runs in the container (the /tmp that fills is the container layer on the host root disk).
TMPDISK_SOURCE_CMD=docker exec -u node ${PAPERCLIP_CONTAINER} df -P -B1 /tmp
# no inner quotes in these two lines: systemd strips them from an EnvironmentFile value
TMPDISK_TOP_CMD=docker exec -u node ${PAPERCLIP_CONTAINER} du -x -d1 -k /tmp
# TMPDISK_WARN_PCT=80
# TMPDISK_CRIT_PCT=90
# Warn on fast growth between two consecutive samples even below the level
# (case_76fe8329): used-bytes jump at or above this trips warn, never page.
# TMPDISK_GROWTH_WARN_BYTES=5368709120
# Previous readings older than this are ignored (reboot/timer gap safety).
# TMPDISK_GROWTH_MAX_AGE_SEC=1800
# Where the previous good reading is kept (default ~/.cache/paperclip/...).
# TMPDISK_STATE_FILE=/home/operator/.cache/paperclip/tmp-disk-alarm.prev
