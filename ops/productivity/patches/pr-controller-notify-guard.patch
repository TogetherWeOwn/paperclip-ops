+def notify_author_wake(state, detail, required):
+    """Decide whether a controller state warrants an author-action wake.
+
+    Notification-only gate for the initial-wake and stale-reminder emission
+    sites (and the host PR pump, which re-renders stored ``ci_red`` through
+    ``wake_text`` with an empty red list): returns ``('wake'|'suppress',
+    reason)``. ``suppress`` fires only for ``ci_red`` with no
+    author-actionable failure. Verdicts, eligibility, checks and gates are
+    unchanged: a suppressed wake still leaves CI red. Unknown required sets
+    fail closed to ``wake``.
+    """
+    return notify_guard.author_wake(
+        state, detail, required,
+        known_base_executed=notify_guard.KNOWN_BASE_EXECUTED)
+
