# Install as /etc/paperclip/ci-node93f4bccf-guard.env with owner root:root, mode 0600.
# This file contains nonsecret settings only. Provision the GitHub credential with:
# systemd-creds encrypt - /etc/credstore.encrypted/ci-node93f4bccf-guard-gh-token
# The credential needs org runner read plus repo variable write on exactly
# TogetherWeOwn/paperclip-ops (org admin provisions it; the broker App
# profile carries neither). Never put GH_TOKEN in this file.
nodecf677d86_GH_ORG=TogetherWeOwn
nodecf677d86_GH_REPO=TogetherWeOwn/paperclip-ops
nodecf677d86_LABEL=two-node93f4bccf
nodecf677d86_VAR=CI_nodecf677d86_RUNNER
nodecf677d86_VALUE=["self-hosted","two-node93f4bccf"]
nodecf677d86_API_URL=https://api.github.com
