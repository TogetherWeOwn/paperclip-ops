# Install as /etc/paperclip/project-regen-prune.env with owner root:root, mode 0600.
# This template is nonsecret. The API key line below is a PLACEHOLDER: the
# operator replaces it by hand on the host. Never commit a real value.
#
# The pruner runs on the HOST as ubuntu (the project checkouts and the host
# /proc the per-worktree liveness gate reads are visible there, not in the
# container):
PAPERCLIP_API_URL=https://host-48c35084.example.invalid
PAPERCLIP_COMPANY_ID=00000000-0000-4000-8000-000000000004
PAPERCLIP_API_KEY=REPLACE_ME_ON_THE_HOST
# Volume knob, the ONLY thing this file may change about a run. 0 = observe-only
# (full evaluation and report, zero removals). Raise it after reading a report;
# a stale project worktree's git-proven ignored+untracked regen dir with no
# live run is the only thing a positive cap lets the pruner remove, never more
# than this many per run.
PROJECT_REGEN_PRUNE_MAX_REMOVE=0
# Path overrides for nonstandard hosts (defaults are the node7b1ff338 host paths).
#PROJECT_REGEN_PRUNE_PROJECTS_ROOT=/home/ubuntu/stacks/paperclip/data/instances/default/projects
#PROJECT_REGEN_PRUNE_MANIFEST_DIR=/var/lib/paperclip/project-regen-prune
# Kill switch: uncomment to make every run exit before any evaluation.
#PROJECT_REGEN_PRUNE_DISABLED=1
