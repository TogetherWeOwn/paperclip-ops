# Install as /etc/paperclip/worktree-prune.env with owner root:root, mode 0600.
# This template is nonsecret. The API key line below is a PLACEHOLDER: the
# operator replaces it by hand on the host. Never commit a real value.
#
# The pruner runs inside this container (the worktrees and the API it reads are
# visible there, not on the host):
PAPERCLIP_WORKTREE_PRUNE_CONTAINER=paperclip
# Read-only API access is enough: the pruner only GETs execution-workspaces,
# issues and live-runs. Use an agent-scoped, read-capable key, not a board key.
# Same URL the agents' runs use (it is read from inside the container).
PAPERCLIP_API_URL=https://host-48c35084.example.invalid
PAPERCLIP_COMPANY_ID=00000000-0000-4000-8000-000000000004
PAPERCLIP_API_KEY=REPLACE_ME_ON_THE_HOST
# Volume knob, the ONLY thing this file may change about a run. 0 = observe-only
# (full evaluation and report, zero removals). Raise it after reading a report;
# a worktree older than 24h on a done/cancelled card with no live run is the
# only thing a positive cap lets the pruner remove, never more than this many
# per run.
PAPERCLIP_WORKTREE_PRUNE_MAX_REMOVE=0
# Kill switch: uncomment to make every run exit before any evaluation. The
# files <root>/.worktree-prune.disabled and <root>/.case_e129e5c6-cutover-active in
# the container are equivalent switches.
#WORKTREE_PRUNE_DISABLED=1
